DB_HOST=localhost
DB_PORT=3306
# On normal operation, use the restricted runtime account here, not root.
DB_USER=hrgsms_app
DB_PASSWORD=your_runtime_password
# The migration account is also used for priviledged operations.
DB_ADMIN_USER=hrgsms_migrator
DB_ADMIN_PASSWORD=strong-migration-password
DB_NAME=hrgsms
PORT=4000
FRONTEND_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=replace_with_a_32_character_or_longer_secret
