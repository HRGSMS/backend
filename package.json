{
  "name": "backend",
  "version": "1.0.0",
  "description": "The Backend Repository for HRGMS",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:init": "cross-env DB_USE_ADMIN=true node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:destroy": "node db/destroy.js",
    "db:recreate": "node db/recreate.js && npm run db:init && npm run auth:migrate && npm run db:seed && npm run auth:seed",
    "db:test-triggers": "cross-env DB_USE_ADMIN=true node db/test-triggers.js",
    "auth:migrate": "cross-env DB_USE_ADMIN=true npx auth@latest migrate && cross-env DB_USE_ADMIN=true node db/migrate-guest-auth.js",
    "auth:seed": "node db/seed-auth.js",
    "api:test": "node scripts/api-tests.js",
    "test": "npm run db:test-triggers && npm run api:test",
    "migrate": "cross-env DB_USE_ADMIN=true node db/migrate.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HRGSMS/backend.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/HRGSMS/backend/issues"
  },
  "homepage": "https://github.com/HRGSMS/backend#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^3.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "node-cron": "^4.6.0",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.2",
    "twilio": "^6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "nodemon": "^1.14.10",
    "prettier": "^3.9.6"
  }
}
